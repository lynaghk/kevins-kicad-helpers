#!/usr/bin/env bash
set -euo pipefail

if [[ -n "${KICAD_CLI:-}" ]]; then
  exec "${KICAD_CLI}" "$@"
fi

if [[ "$(uname -s)" == "Darwin" ]]; then
  app=/Applications/KiCad/KiCad.app
  executable="${app}/Contents/MacOS/kicad-cli"

  if [[ ! -x "${executable}" ]]; then
    echo "Could not find kicad-cli at ${executable}." >&2
    exit 1
  fi

  source "$(dirname "$(dirname "$(realpath "${BASH_SOURCE[0]}")")")/fontconfig/env.bash"
  kkh_export_fontconfig "${app}"

  exec "${executable}" "$@"
fi

shim="$(realpath "$0")"
while IFS= read -r executable; do
  if [[ "$(realpath "${executable}")" != "${shim}" ]]; then
    exec "${executable}" "$@"
  fi
done < <(type -aP kicad-cli)

if command -v flatpak >/dev/null && flatpak info org.kicad.KiCad >/dev/null 2>&1; then
  exec flatpak run \
    --filesystem="${PWD}":rw \
    --command=/app/bin/kicad-cli \
    org.kicad.KiCad \
    "$@"
fi

echo "Could not find kicad-cli." >&2
echo "Set KICAD_CLI, install KiCad, or install the org.kicad.KiCad Flatpak." >&2
exit 1
