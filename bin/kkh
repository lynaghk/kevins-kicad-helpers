#!/usr/bin/env bash
#
# Entry point for the project tasks: kkh list | check | build.
#
# Works from anywhere inside a consuming KiCad repository (the Clojure side
# resolves the Git root and scans it for KiCad projects).
# Consuming repos need no bb.edn and no tool pins of their own: every tool
# runs at the version pinned in this repo's mise.toml, so invoking this script
# is the whole contract. The only requirement is mise itself.

set -euo pipefail

SCRIPT_DIR=$(dirname "$(realpath "${BASH_SOURCE[0]}")")
KKH_REPO=$(realpath "$SCRIPT_DIR/..")
export KKH_REPO

if [[ "${1:-}" == "macos-opener" ]]; then
    shift
    exec "$KKH_REPO/macos-opener/bin/macos-opener" "$@"
fi

if ! command -v mise >/dev/null 2>&1; then
    echo "Error: kkh needs 'mise' on PATH (https://mise.jdx.dev) to provide its pinned tools." >&2
    exit 1
fi

# @ Load KKH's toolchain without changing the consuming project's directory.
mise trust "$KKH_REPO/mise.toml" >/dev/null 2>&1 || true
mise -C "$KKH_REPO" install --quiet
eval "$(mise -C "$KKH_REPO" env -s bash)"

# Sibling shims (kicad-cli, fabrication-toolkit, ...) must be resolvable even
# when the consumer's environment doesn't put this bin/ on PATH.
export PATH="$SCRIPT_DIR:$PATH"

if [[ "${1:-}" == "setup-kicad-libraries" ]]; then
    shift
    exec uv run --frozen --project "$KKH_REPO/kicad-libraries" python "$KKH_REPO/kicad-libraries/setup_kicad_libraries.py" "$@"
fi

exec bb --classpath "$KKH_REPO/project-tasks/src" -m project-tasks.dispatch "$@"
