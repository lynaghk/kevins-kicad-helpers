#!/usr/bin/env bash

set -euo pipefail

usage() {
    cat <<EOF
Usage: $(basename "$0") <schematic>

Run kicad-analyzer's check-schematic! on the given KiCad schematic file.

Options:
  -h, --help    Show this help message and exit

Arguments:
  <schematic>   Path to the KiCad schematic file to analyze
EOF
}

if [[ $# -eq 0 ]]; then
    usage
    exit 1
fi

case "$1" in
    -h|--help)
        usage
        exit 0
        ;;
esac

if [[ $# -ne 1 ]]; then
    echo "Error: expected exactly one argument" >&2
    usage
    exit 1
fi

SCHEMATIC="$1"

if [[ ! -f "$SCHEMATIC" ]]; then
    echo "Error: file not found: $SCHEMATIC" >&2
    exit 1
fi


SCHEMATIC=$(realpath "$SCHEMATIC")

SCRIPT_DIR=$(dirname "$(realpath "${BASH_SOURCE[0]}")")
KKH_REPO=$(realpath "$SCRIPT_DIR/..")
mise trust "$KKH_REPO/mise.toml" >/dev/null 2>&1 || true
mise -C "$KKH_REPO" install --quiet
eval "$(mise -C "$KKH_REPO" env -s bash)"
export PATH="$SCRIPT_DIR:$PATH"
export SCHEMATIC
cd "$KKH_REPO/analyzer"

# @ Pass the path as data, including spaces and Clojure string delimiters.
exec clojure -M -e '(do (require (quote kicad-analyzer.core)) (kicad-analyzer.core/check-schematic! (System/getenv "SCHEMATIC")))'
