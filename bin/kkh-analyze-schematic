#!/usr/bin/env bash

set -euo pipefail

usage() {
    cat <<EOF
Usage: $(basename "$0") <schematic>

Run kicad-analyzer's check-schematic! on the given KiCad schematic file.

Options:
  -h, --help    Show this help message and exit

Arguments:
  <schematic>   Path to the KiCad schematic file to analyze
EOF
}

if [[ $# -eq 0 ]]; then
    usage
    exit 1
fi

case "$1" in
    -h|--help)
        usage
        exit 0
        ;;
esac

if [[ $# -ne 1 ]]; then
    echo "Error: expected exactly one argument" >&2
    usage
    exit 1
fi

SCHEMATIC="$1"

if [[ ! -f "$SCHEMATIC" ]]; then
    echo "Error: file not found: $SCHEMATIC" >&2
    exit 1
fi


SCHEMATIC=$(realpath "$SCHEMATIC")

# The analyzer lives alongside this script in ../analyzer. We run from inside it
# so deps.edn, src paths, and the mise-managed tool versions all resolve.
SCRIPT_DIR=$(dirname "$(realpath "${BASH_SOURCE[0]}")")
ANALYZER_DIR="$SCRIPT_DIR/../analyzer"
cd "$ANALYZER_DIR"

exec mise exec -- clojure -M -e "(do (require 'kicad-analyzer.core) (kicad-analyzer.core/check-schematic! \"$SCHEMATIC\"))"
