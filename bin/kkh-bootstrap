#!/usr/bin/env bash
#
# Bootstrap a KiCad project to use kevins-kicad-helpers' project tasks.
#
# Run from the root of your project directory. Vendors this repo as a git
# submodule under vendor/kevins-kicad-helpers, then writes a bb.edn (mounting
# the project-tasks library) and a mise.toml (babashka + the helpers' bin on
# PATH). On any blocking error it prints a manual runbook and exits non-zero.

set -euo pipefail

SCRIPT_DIR=$(dirname "$(realpath "${BASH_SOURCE[0]}")")
KKH_REPO=$(realpath "$SCRIPT_DIR/..")
ORIGIN_URL=$(git -C "$KKH_REPO" remote get-url origin 2>/dev/null || true)
URL_FOR_DOCS="${ORIGIN_URL:-https://github.com/lynaghk/kevins-kicad-helpers}"

read -r -d '' BB_EDN <<'EOF' || true
{:paths ["vendor/kevins-kicad-helpers/project-tasks/src"]
 :tasks
 {list  {:doc "List KiCad PCB projects."
         :requires ([project-tasks.dispatch :as dispatch])
         :task (System/exit (dispatch/run! "list" *command-line-args*))}
  check {:doc "Check KiCad PCB projects (ERC/DRC + custom checks)."
         :requires ([project-tasks.dispatch :as dispatch])
         :task (System/exit (dispatch/run! "check" *command-line-args*))}
  build {:doc "Build KiCad PCB production outputs."
         :requires ([project-tasks.dispatch :as dispatch])
         :task (System/exit (dispatch/run! "build" *command-line-args*))}}}
EOF

read -r -d '' MISE_TOML <<'EOF' || true
[tools]
"github:babashka/babashka" = "1.12.218"

[env]
_.path = ["{{config_root}}/vendor/kevins-kicad-helpers/bin"]
EOF

manual() {
  cat >&2 <<EOF

kkh-bootstrap couldn't finish automatically. To set up the project by hand:

  1. Initialize a git repo (if needed):    git init
  2. Vendor the helpers:
       git submodule add $URL_FOR_DOCS vendor/kevins-kicad-helpers
       git submodule update --init --recursive
  3. Create bb.edn with:
$BB_EDN
  4. Create mise.toml with:
$MISE_TOML
  5. Install tools and try it:             touch mise.lock && mise install && bb list
EOF
}
die() { echo "Error: $1" >&2; manual; exit 1; }

git rev-parse --is-inside-work-tree >/dev/null 2>&1 || die "current directory is not a git repository."
[ -n "$ORIGIN_URL" ] || die "the kevins-kicad-helpers checkout at $KKH_REPO has no 'origin' remote."
[ ! -e vendor/kevins-kicad-helpers ] || die "vendor/kevins-kicad-helpers already exists."
[ ! -e bb.edn ] || die "bb.edn already exists (project looks already set up)."

git submodule add "$ORIGIN_URL" vendor/kevins-kicad-helpers
git submodule update --init --recursive

printf '%s\n' "$BB_EDN" > bb.edn
if [ -e mise.toml ]; then
  cat >&2 <<EOF
Note: mise.toml already exists; leaving it. Merge in the following so it pins
      babashka and adds the helpers' bin to PATH:

$MISE_TOML
EOF
else
  printf '%s\n' "$MISE_TOML" > mise.toml
  touch mise.lock            # mise only maintains the lockfile when it already exists
fi

# Install the pinned tools (trust the freshly written config first). Non-fatal:
# the project is already vendored/configured, so a missing or offline mise just
# leaves a note rather than aborting.
if command -v mise >/dev/null 2>&1; then
  mise trust >/dev/null 2>&1 || true
  mise install || echo "Note: 'mise install' failed; re-run it once your environment is ready." >&2
else
  echo "Note: 'mise' is not on PATH; install it, then run 'mise install'." >&2
fi

cat <<'EOF'
Bootstrapped KiCad project tasks. Next steps:
  mkdir -p pcbs/<board>       # each board's .kicad_pro/.kicad_sch/.kicad_pcb goes here
  bb list                     # list discovered boards, then: bb check/build <board>
EOF
