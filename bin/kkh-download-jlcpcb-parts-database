#!/usr/bin/env bash
#
# Downloads the JLCPCB parts database and builds a self-contained `components_simplified` table.
# I browse this with https://sqlitebrowser.org/ and also have LLM agents use it to find potential parts for me.
#
# Output is always ./jlcpcb_parts.db (stable path, overwritten each run). The build date lives in
# a `meta` table inside the DB rather than in the filename or filesystem mtime, so it survives
# copying/rsync/git. Query it with:  SELECT value FROM meta WHERE key='generated_at';

set -euo pipefail

DOWNLOAD_URL="https://cdfer.github.io/jlcpcb-parts-database/jlcpcb-components.sqlite3"
RAW_FILE="jlcpcb-raw.sqlite3"
OUTPUT_FILE="jlcpcb_parts.db"
GENERATED_AT=$(date -u +"%Y-%m-%dT%H:%M:%SZ")

echo "Downloading JLCPCB parts database..."
curl -L -o "$RAW_FILE" "$DOWNLOAD_URL"

echo "Building materialized components_simplified table..."
rm -f "$OUTPUT_FILE" "$OUTPUT_FILE"-*
sqlite3 "$RAW_FILE" <<EOF 2>&1
ATTACH DATABASE '${OUTPUT_FILE}' AS out;

-- Explicit column types so consumers get a real REAL price column (and typed
-- integer columns) — no CAST(price AS REAL) needed at query time.
CREATE TABLE out.components_simplified (
    lcsc        INTEGER,
    extended    INTEGER,   -- 0 = basic/preferred (fee-free), 1 = extended
    stock       INTEGER,
    price       REAL,      -- USD, first (smallest-qty / highest) tier; NULL if unknown
    mfr         TEXT,      -- manufacturer PART NUMBER (MPN), not the maker's name
    category    TEXT,
    subcategory TEXT,
    package     TEXT,
    joints      INTEGER,
    description TEXT,
    datasheet   TEXT
);

INSERT INTO out.components_simplified
SELECT lcsc,
       -- 1 = extended part (incurs per-BOM-line feeding fee at assembly);
       -- 0 = basic/preferred, i.e. effectively fee-free. JLCPCB's basic and
       -- preferred tiers are functionally the same for our purposes, so we
       -- collapse both into a single "extended" boolean.
       CASE WHEN basic = 0 AND preferred = 0 THEN 1 ELSE 0 END AS extended,
       stock,
       -- price is an upstream JSON array of quantity tiers; [0] is the first
       -- (smallest-quantity) tier, i.e. the highest unit price you'd pay.
       -- json_valid() guards against a malformed row aborting the whole build;
       -- missing/empty/non-numeric prices coerce to NULL (not a bogus 0.0),
       -- and the REAL column affinity above cements the value as a real number.
       ROUND(
         CASE WHEN json_valid(price)
              THEN json_extract(price, '\$[0].price')
              ELSE NULL END,
       3) AS price,
       mfr, category, subcategory, package, joints, description, datasheet
FROM components
INNER JOIN categories ON components.category_id = categories.id;

-- Indexes for the columns you actually filter / sort on.
CREATE INDEX out.idx_cs_category ON components_simplified (category, subcategory);
CREATE INDEX out.idx_cs_price    ON components_simplified (price);
CREATE INDEX out.idx_cs_stock    ON components_simplified (stock);
CREATE INDEX out.idx_cs_extended ON components_simplified (extended);
CREATE INDEX out.idx_cs_package  ON components_simplified (package);
CREATE INDEX out.idx_cs_mfr      ON components_simplified (mfr);

-- Build provenance: durable, travels with the DB.
CREATE TABLE out.meta (key TEXT PRIMARY KEY, value TEXT);
INSERT INTO out.meta (key, value) VALUES
  ('generated_at', '${GENERATED_AT}'),
  ('source_url',   '${DOWNLOAD_URL}'),
  ('row_count',    (SELECT CAST(COUNT(*) AS TEXT) FROM out.components_simplified));

ANALYZE out;
EOF

echo "Compacting..."
sqlite3 "$OUTPUT_FILE" "VACUUM;"

# Drop any old date-suffixed builds from previous versions of this script.
rm -f JLCPCB_*.db JLCPCB_*.db-* jlcpcb-raw_*.sqlite3 jlcpcb-raw_*.sqlite3-*

# The raw ~1.7 GB download is no longer needed once we've materialized.
# Comment this out if you want to keep the full upstream DB around.
rm -f "$RAW_FILE" "$RAW_FILE"-*

echo "Done: $OUTPUT_FILE ($(du -h "$OUTPUT_FILE" | cut -f1)), generated_at=${GENERATED_AT}"
