#!/usr/bin/env bash
#
# Downloads the JLCPCB parts database and builds a self-contained `components_simplified` table.
# I browse this with https://sqlitebrowser.org/ and also have LLM agents use it to find potential parts for me.

set -euo pipefail

# Skip if we already built a simplified DB.
EXISTING=$(ls JLCPCB_*.db 2>/dev/null | head -n 1 || echo "")
if [ -n "$EXISTING" ]; then
    echo "Already built, exiting: $EXISTING"
    exit 0
fi

DOWNLOAD_URL="https://cdfer.github.io/jlcpcb-parts-database/jlcpcb-components.sqlite3"
CURRENT_DATE=$(date +"%Y_%m_%d")
RAW_FILE="jlcpcb-raw_${CURRENT_DATE}.sqlite3"
OUTPUT_FILE="JLCPCB_${CURRENT_DATE}.db"

echo "Downloading JLCPCB parts database..."
curl -L -o "$RAW_FILE" "$DOWNLOAD_URL"

echo "Building materialized components_simplified table..."
rm -f "$OUTPUT_FILE" "$OUTPUT_FILE"-*
sqlite3 "$RAW_FILE" <<EOF 2>&1
ATTACH DATABASE '${OUTPUT_FILE}' AS out;

CREATE TABLE out.components_simplified AS
SELECT lcsc,
       -- 1 = extended part (incurs per-BOM-line feeding fee at assembly);
       -- 0 = basic/preferred, i.e. effectively fee-free. JLCPCB's basic and
       -- preferred tiers are functionally the same for our purposes, so we
       -- collapse both into a single "extended" boolean.
       CASE WHEN basic = 0 AND preferred = 0 THEN 1 ELSE 0 END AS extended,
       stock,
       ROUND(json_extract(price, '\$[0].price'), 3) AS price,
       mfr, category, subcategory, package, joints, description, datasheet
FROM components
INNER JOIN categories ON components.category_id = categories.id;

-- Indexes for the columns you actually filter / sort on.
CREATE INDEX out.idx_cs_category ON components_simplified (category, subcategory);
CREATE INDEX out.idx_cs_price    ON components_simplified (price);
CREATE INDEX out.idx_cs_stock    ON components_simplified (stock);
CREATE INDEX out.idx_cs_extended ON components_simplified (extended);
CREATE INDEX out.idx_cs_package  ON components_simplified (package);
CREATE INDEX out.idx_cs_mfr      ON components_simplified (mfr);

ANALYZE out;
EOF

echo "Compacting..."
sqlite3 "$OUTPUT_FILE" "VACUUM;"

# The raw ~1.7 GB download is no longer needed once we've materialized.
# Comment this out if you want to keep the full upstream DB around.
rm -f "$RAW_FILE" "$RAW_FILE"-*

echo "Done: $OUTPUT_FILE ($(du -h "$OUTPUT_FILE" | cut -f1))"
